# Copy this file to .env and fill in real values. Never commit .env itself.

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=supportassist
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Generate a real random 64-char secret for production, e.g.:
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change_this_to_a_long_random_string
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=1209600

UPLOAD_DIR=storage/uploads
UPLOAD_MAX_BYTES=5242880

# Simple in-memory-per-request rate limit window (see RateLimitMiddleware)
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Firebase Cloud Messaging — see FcmService.php docblock for setup steps.
# Leave FCM_PROJECT_ID blank in dev and pushes just no-op instead of erroring.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=storage/firebase-service-account.json
